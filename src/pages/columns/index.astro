---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import { getSubjectName } from "@/utils/subjects";
import config from "@/config";

const allEntries = await getCollection("columns");
const sorted = allEntries.sort(
  (a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);

const bySubject = new Map<string, typeof sorted>();
for (const entry of sorted) {
  const s = entry.data.subject;
  if (!bySubject.has(s)) bySubject.set(s, []);
  bySubject.get(s)!.push(entry);
}

const subjects = [...bySubject.entries()].sort(([a], [b]) =>
  a.localeCompare(b)
);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.nav.columns} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-4">
    <h1 class="text-2xl font-semibold sm:text-3xl">{t.nav.columns}</h1>
    <p class="mt-2 mb-6 italic">专栏文章</p>

    <ul class="space-y-2">
      {subjects.map(([subject, entries]) => (
        <li>
          <a
            href={getRelativeLocaleUrl(locale, `columns/${subject}`)}
            class="text-accent text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
          >
            {getSubjectName(subject)}
          </a>
          <span class="text-muted-foreground ml-2 text-sm">
            ({entries.length} 篇)
          </span>
          <p class="text-muted-foreground text-sm leading-relaxed">
            {entries[0].data.description}
          </p>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
</Layout>
