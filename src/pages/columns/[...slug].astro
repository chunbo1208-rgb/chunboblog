---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import ColumnPaperList from "@/components/ColumnPaperList.astro";
import { getSubjectName } from "@/utils/subjects";
import config from "@/config";

type ColumnEntry = CollectionEntry<"columns">;

function getEntryPath(entry: ColumnEntry): string {
  return entry.id.replace(/\/index$/, "");
}

function getContestKey(entry: ColumnEntry): string | undefined {
  if (entry.data.contest) return entry.data.contest;
  const [, contest] = entry.id.split("/");
  return contest;
}

export async function getStaticPaths() {
  const entries = await getCollection("columns");
  const getStaticEntryPath = (entry: CollectionEntry<"columns">) =>
    entry.id.replace(/\/index$/, "");
  const subjects = [...new Set(entries.map(entry => entry.data.subject))];
  const subjectPaths = subjects.map(subject => ({
    params: { slug: subject },
    props: { pageType: "subject" as const, subject, entries },
  }));
  const entryPaths = entries.map(entry => ({
    params: { slug: getStaticEntryPath(entry) },
    props: { pageType: "entry" as const, entry, entries },
  }));

  return [...subjectPaths, ...entryPaths];
}

type Props =
  | { pageType: "subject"; subject: string; entries: ColumnEntry[] }
  | { pageType: "entry"; entry: ColumnEntry; entries: ColumnEntry[] };

const props = Astro.props as Props;
const locale = Astro.currentLocale ?? config.site.lang;
const columnUrl = (path: string) =>
  getRelativeLocaleUrl(locale, `columns/${path}`);

let subject: string;
let subjectEntries: ColumnEntry[];
let entry: ColumnEntry | undefined;

if (props.pageType === "subject") {
  subject = props.subject;
  subjectEntries = props.entries.filter(item => item.data.subject === subject);
} else {
  entry = props.entry;
  subject = entry.data.subject;
  subjectEntries = props.entries.filter(item => item.data.subject === subject);
}

const contests = subjectEntries
  .filter(item => item.data.entryType === "contest")
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const standalonePapers = subjectEntries
  .filter(
    item =>
      item.data.entryType === "paper" &&
      !contests.some(contest => getContestKey(contest) === getContestKey(item))
  )
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());
const activeContest = entry ? getContestKey(entry) : undefined;
const contestPapers = activeContest
  ? subjectEntries
      .filter(
        item =>
          item.data.entryType === "paper" &&
          getContestKey(item) === activeContest
      )
      .sort(
        (a, b) =>
          (b.data.year ?? 0) - (a.data.year ?? 0) ||
          b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
      )
  : [];
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const pageTitle = entry?.data.title ?? getSubjectName(subject);
const description =
  entry?.data.description ??
  `Browse ${getSubjectName(subject)} column entries.`;
---

<Layout title={`${pageTitle} | ${config.site.title}`} {description}>
  <Header />

  <nav class="app-layout mt-8 mb-1 text-sm" aria-label="breadcrumb">
    <a class="opacity-70 hover:opacity-100" href={columnUrl("")}>Columns</a>
    <span aria-hidden="true" class="mx-1 opacity-60">&raquo;</span>
    {
      entry ? (
        <>
          <a class="opacity-70 hover:opacity-100" href={columnUrl(subject)}>
            {getSubjectName(subject)}
          </a>
          <span aria-hidden="true" class="mx-1 opacity-60">
            &raquo;
          </span>
          <span aria-current="page" class="opacity-80">
            {entry.data.title}
          </span>
        </>
      ) : (
        <span aria-current="page" class="opacity-80">
          {getSubjectName(subject)}
        </span>
      )
    }
  </nav>

  <main id="main-content" class="app-layout pb-8" data-pagefind-body>
    <header class="mt-6 mb-8 border-b border-dashed pb-6">
      <p
        class="text-accent mb-2 text-sm font-semibold tracking-widest uppercase"
      >
        {entry?.data.entryType === "paper" ? "Contest paper" : "Column"}
      </p>
      <h1 class="text-3xl font-bold sm:text-4xl">{pageTitle}</h1>
      <p class="text-muted-foreground mt-3 max-w-2xl leading-relaxed">
        {description}
      </p>
      {
        entry?.data.entryType === "paper" && (
          <div class="mt-3 text-sm">
            <Datetime
              pubDatetime={entry.data.pubDatetime}
              modDatetime={entry.data.modDatetime}
            />
          </div>
        )
      }
    </header>

    {
      props.pageType === "subject" ? (
        <>
          {contests.length > 0 && (
            <section aria-labelledby="contest-series">
              <h2 id="contest-series" class="mb-4 text-xl font-semibold">
                Contest series
              </h2>
              <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {contests.map(contest => {
                  const paperCount = subjectEntries.filter(
                    item =>
                      item.data.entryType === "paper" &&
                      getContestKey(item) === getContestKey(contest)
                  ).length;
                  return (
                    <li class="border-border bg-muted/20 rounded-sm border p-5">
                      <a
                        class="text-accent text-xl font-semibold decoration-dashed underline-offset-4 hover:underline"
                        href={columnUrl(getEntryPath(contest))}
                      >
                        {contest.data.title}
                      </a>
                      <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                        {contest.data.description}
                      </p>
                      <p class="mt-4 text-xs tracking-wide uppercase opacity-70">
                        {paperCount} {paperCount === 1 ? "paper" : "papers"}
                      </p>
                    </li>
                  );
                })}
              </ul>
            </section>
          )}

          {standalonePapers.length > 0 && (
            <section class="mt-10" aria-labelledby="other-papers">
              <h2 id="other-papers" class="mb-3 text-xl font-semibold">
                Other papers
              </h2>
              <ColumnPaperList papers={standalonePapers} />
            </section>
          )}
        </>
      ) : (
        <>
          {Content && (
            <article class="app-prose max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)">
              <Content />
            </article>
          )}

          {entry?.data.entryType === "contest" && (
            <section
              class="mt-10 border-t border-dashed pt-7"
              aria-labelledby="papers"
            >
              <div class="mb-4 flex items-baseline justify-between gap-4">
                <h2 id="papers" class="text-2xl font-semibold">
                  Papers
                </h2>
                <span class="text-muted-foreground text-sm">
                  {contestPapers.length} total
                </span>
              </div>
              {contestPapers.length > 0 ? (
                <ColumnPaperList papers={contestPapers} />
              ) : (
                <p class="text-muted-foreground italic">
                  No papers have been added to this series yet.
                </p>
              )}
            </section>
          )}
        </>
      )
    }
  </main>

  <Footer />
</Layout>
