---
type Props = {
  title: string;
  open?: boolean;
};

// Destructure title and the default 'open' state (defaults to false if not provided)
const { title, open = false } = Astro.props;
---

<details open={open} class="border border-border bg-muted/10 my-4 rounded-lg overflow-hidden">
  <summary class="font-medium p-4 cursor-pointer select-none bg-muted/20 hover:bg-muted/30 transition-colors flex items-center justify-between list-none [&::-webkit-details-marker]:hidden">
    <span>{title}</span>
    <span class="chevron opacity-70 transition-transform duration-200">&darr;</span>
  </summary>
  <div class="p-4 border-t border-border bg-background prose max-w-none">
    <slot />
  </div>
</details>

<style>
  /* Optional: Adds a smooth rotation effect to a custom indicator when opened */
  details[open] .chevron {
    transform: rotate(180deg);
  }
</style>